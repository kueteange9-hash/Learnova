# ==========================================================
# Learnova backend environment variables
# Copy this file to `.env` (backend/.env) and fill in values.
# The `.env` file is git-ignored and must NEVER be committed.
# ==========================================================

# PostgreSQL connection string (Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/learnova"

# Secret used to sign the learner/specialist/admin JWTs
JWT_SECRET="change_me_to_a_long_random_string"

# Port for the Express API
PORT=3001

# ==========================================================
# Google Gemini — Learnova AI Guidance Chat
# Get a key: https://aistudio.google.com/apikey
# This key is used ONLY by the backend (src/services/geminiService.js).
# It is never sent to the browser.
# ==========================================================
GEMINI_API_KEY=your_actual_key_here

# Optional: override the model (defaults to gemini-3.8-flash and falls back
# automatically if that model is not available for your key)
# GEMINI_MODEL=gemini-3.8-flash

# Optional: request timeout in milliseconds (default 30000)
# GEMINI_TIMEOUT_MS=30000

# Optional: only needed for tests / proxies
# GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com

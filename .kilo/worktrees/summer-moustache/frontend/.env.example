# ==========================================================
# Learnova frontend environment variables (optional)
# Copy to `.env.local` only if you need to override a default.
# ==========================================================

# Where the Express API runs. The frontend proxies /api/backend/* and
# /uploads/* to this URL (see next.config.js), which is what makes the app
# work both locally and from a hosted/preview domain.
# BACKEND_URL=http://127.0.0.1:3001

# Advanced: call the API directly from the browser instead of using the
# Next.js proxy (then BACKEND_URL/proxy is not used for API calls).
# NEXT_PUBLIC_API_URL=http://localhost:3001/api

# NOTE: the Google Gemini API key belongs ONLY in backend/.env.
#       It must never be placed in a NEXT_PUBLIC_* variable.
